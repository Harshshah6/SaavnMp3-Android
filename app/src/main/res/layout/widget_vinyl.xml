<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <!-- Vinyl Disc Container -->
    <FrameLayout
        android:id="@+id/vinyl_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/widget_vinyl_grooves">

        <!-- Center Album Art (Circle cropped by Glide) -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <!-- Center Spindle Hole -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_vinyl_spindle" />

    </FrameLayout>

    <!-- Floating Compact Pill Controls (Overlaid at bottom) -->
    <LinearLayout
        android:id="@+id/vinyl_control_pill"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_pill_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <!-- Song info -->
        <LinearLayout
            android:id="@+id/text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontFamily="@font/avenir_next_bold"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Not Playing"
                android:textColor="@color/widget_text_title"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/avenir_next_regular"
                android:maxLines="1"
                android:text="Melotune"
                android:textColor="@color/widget_text_subtitle"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Mini Controls -->
        <ImageView
            android:id="@+id/button_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Previous"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/skip_previous_24px"
            app:tint="@color/widget_text_title" />

        <FrameLayout
            android:id="@+id/button_play_pause_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="3dp">

            <ImageView
                android:id="@+id/button_play_pause_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_fab_play_pause" />

            <ImageView
                android:id="@+id/button_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Play/Pause"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/play_arrow_24px" />
        </FrameLayout>

        <ImageView
            android:id="@+id/button_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Next"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/skip_next_24px"
            app:tint="@color/widget_text_title" />

    </LinearLayout>

</RelativeLayout>
