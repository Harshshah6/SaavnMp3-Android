<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    tools:context=".activities.ListActivity">

    <!-- Material 3 Toolbar -->
    <LinearLayout
        android:id="@+id/__toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/round_arrow_back_24"
            android:contentDescription="Back"
            android:onClick="backPress"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/textMain" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/share_icon"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/share_24px"
            android:contentDescription="Share"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/textMain" />

        <ImageView
            android:id="@+id/more_icon"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/more_vert_24px"
            android:contentDescription="More Options"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/textMain" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/__divider"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        app:dividerColor="@color/dividerBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/__toolbar" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.38" />

    <!-- Left Header Pane inside NestedScrollView to prevent vertical clipping on short displays -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/header_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/mini_player"
        app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/__divider">

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:gravity="center_horizontal">

            <!-- Hero Cover Squircle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/album_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Album Art" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/albumTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="Playlist Title"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="@font/avenir_next_bold"
                android:textColor="@color/textMain"
                android:textAlignment="center"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/albumSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Playlist • Year"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:scrollHorizontally="true"
                android:lines="1"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/avenir_next_regular"
                android:textColor="@color/textSec"
                android:textAlignment="center" />

            <!-- Action Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playAllBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play"
                    android:fontFamily="@font/avenir_next_bold"
                    app:icon="@drawable/play_arrow_24px"
                    app:iconTint="@color/background"
                    app:iconGravity="textStart"
                    android:textColor="@color/background"
                    app:backgroundTint="@color/buttonBackground"
                    app:cornerRadius="999dp" />

                <!-- Add to Library Button -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    app:cardCornerRadius="999dp"
                    app:cardBackgroundColor="@color/surfaceContainerHighest"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/add_to_library"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/round_add_24"
                        android:contentDescription="Add to library"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/textMain" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Download Album Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/downloadAlbumBtn"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    app:cardCornerRadius="999dp"
                    app:cardBackgroundColor="@color/surfaceContainerHighest"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/downloadAlbumIcon"
                        android:contentDescription="Download Album"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/baseline_download_for_offline_24"
                        android:padding="@dimen/_6sdp"
                        android:clickable="false"
                        android:focusable="false"
                        app:tint="@color/textMain" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:id="@+id/add_more_songs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="+ Add songs"
                android:fontFamily="@font/avenir_next_bold"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/green"
                android:padding="@dimen/_4sdp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Right Track List Pane -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/activity_list_song_item"
        app:layout_constraintBottom_toTopOf="@+id/mini_player"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical_header"
        app:layout_constraintTop_toBottomOf="@id/__divider" />

    <!-- Floating Mini Player -->
    <include
        android:id="@+id/mini_player"
        layout="@layout/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
