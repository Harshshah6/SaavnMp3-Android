<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/widget_pill_background"
    android:paddingStart="9dp"
    android:paddingEnd="12dp"
    android:paddingVertical="8dp">

    <!-- Album Art -->

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="Album Art"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher_round" />

    <!-- Text Information -->
    <LinearLayout
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/controls_container"
        android:layout_toEndOf="@+id/widget_album_art"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:fontFamily="@font/avenir_next_bold"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Not Playing"
            android:textColor="@color/widget_text_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/avenir_next_regular"
            android:maxLines="1"
            android:text="Melotune"
            android:textColor="@color/widget_text_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/button_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Previous"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/skip_previous_24px"
            app:tint="@color/widget_text_title" />

        <!-- Hero Play/Pause Circle FAB -->
        <FrameLayout
            android:id="@+id/button_play_pause_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp">

            <ImageView
                android:id="@+id/button_play_pause_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_fab_play_pause" />

            <ImageView
                android:id="@+id/button_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Play/Pause"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/play_arrow_24px" />
        </FrameLayout>

        <ImageView
            android:id="@+id/button_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Next"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/skip_next_24px"
            app:tint="@color/widget_text_title" />

    </LinearLayout>

</RelativeLayout>
