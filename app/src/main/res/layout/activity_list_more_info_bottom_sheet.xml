<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_16sdp">

    <!-- Material 3 Drag Handle -->
    <View
        android:id="@+id/bar"
        android:layout_width="36dp"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/m3_bottom_sheet_drag_handle"/>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bar"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="vertical">

        <!-- Album Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/surfaceContainerHighest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/_8sdp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/surfaceContainerLow"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/coverImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/surfaceContainerLow"
                        android:contentDescription="Cover Art" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/albumTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:fontFamily="@font/avenir_next_bold"
                        android:textColor="@color/textMain"
                        android:textSize="@dimen/_13ssp"/>

                    <TextView
                        android:id="@+id/albumSubTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/app_name"
                        android:fontFamily="@font/avenir_next_regular"
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/textSec"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.harsh.shah.saavnmp3.utils.customview.BottomSheetItemView
            android:id="@+id/add_to_library"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Add to Library"
            android:src="@drawable/round_add_24"
            app:srcPadding="@dimen/_4sdp"/>

        <com.harsh.shah.saavnmp3.utils.customview.BottomSheetItemView
            android:id="@+id/download_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Download Album"
            android:src="@drawable/baseline_download_for_offline_24"
            app:srcPadding="@dimen/_4sdp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artists"
            android:fontFamily="@font/avenir_next_bold"
            android:textColor="@color/green"
            android:textSize="@dimen/_13ssp"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_4sdp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>