<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.SavedLibrariesActivity"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <!-- Material 3 Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:padding="@dimen/_6sdp"
            android:onClick="backPress"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/actionBarItemBackground"
            android:src="@drawable/round_arrow_back_24"
            app:tint="@color/textMain"
            android:contentDescription="Back"
            tools:ignore="UsingOnClickInXml" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Your Library"
            android:fontFamily="@font/avenir_next_bold"
            android:textColor="@color/textMain"
            android:textSize="@dimen/_18ssp"
            android:layout_weight="1" />

        <ImageView
            android:contentDescription="Import library"
            android:id="@+id/importLibrary"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:src="@drawable/ic_import"
            android:padding="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/textMain"
            tools:ignore="HardcodedText" />

        <ImageView
            android:contentDescription="Export library"
            android:id="@+id/exportLibrary"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:src="@drawable/ic_export"
            android:padding="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/textMain"
            tools:ignore="HardcodedText" />

        <ImageView
            android:contentDescription="Add new library"
            android:id="@+id/addNewLibrary"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:src="@drawable/round_add_24"
            android:padding="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/actionBarItemBackground"
            app:tint="@color/green"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        app:dividerColor="@color/dividerBackground"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/mini_player"
        tools:listitem="@layout/activity_list_song_item"
        android:paddingVertical="@dimen/_6sdp" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/empty_list_tv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_24sdp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/mini_player">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            app:cardCornerRadius="999dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/surfaceContainerHighest">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_14sdp"
                android:src="@drawable/baseline_library_music_24"
                app:tint="@color/textSec" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="No playlists found"
            android:fontFamily="@font/avenir_next_bold"
            android:textColor="@color/textMain"
            android:textSize="@dimen/_15ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Tap + at the top right to create your first playlist or import an existing library."
            android:gravity="center"
            android:fontFamily="@font/avenir_next_regular"
            android:textColor="@color/textSec"
            android:textSize="@dimen/_11ssp" />

    </LinearLayout>

    <!-- Floating Mini Player -->
    <include
        android:id="@+id/mini_player"
        layout="@layout/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>