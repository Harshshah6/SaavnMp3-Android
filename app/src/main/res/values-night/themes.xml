    <style name="Theme.Melotune.Crimson" parent="Base.Theme.Melotune">
        <item name="colorPrimary">@color/crimson_primary_dark</item>
        <item name="colorOnPrimary">@color/crimson_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/crimson_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/crimson_on_primary_container_dark</item>
        <item name="colorSecondary">@color/crimson_secondary_dark</item>
        <item name="colorOnSecondary">@color/crimson_on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/crimson_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/crimson_on_secondary_container_dark</item>
    </style>

    <style name="Theme.Melotune.Amber" parent="Base.Theme.Melotune">
        <item name="colorPrimary">@color/amber_primary_dark</item>
        <item name="colorOnPrimary">@color/amber_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/amber_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/amber_on_primary_container_dark</item>
        <item name="colorSecondary">@color/amber_secondary_dark</item>
        <item name="colorOnSecondary">@color/amber_on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/amber_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/amber_on_secondary_container_dark</item>
    </style>
</resources>