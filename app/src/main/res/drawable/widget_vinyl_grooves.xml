<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Disc Body -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_vinyl_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_outline" />
        </shape>
    </item>

    <!-- Outer Groove Ring 1 -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_vinyl_groove" />
        </shape>
    </item>

    <!-- Outer Groove Ring 2 -->
    <item
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_vinyl_groove" />
        </shape>
    </item>

    <!-- Mid Groove Ring 3 -->
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_vinyl_groove" />
        </shape>
    </item>

    <!-- Mid Groove Ring 4 -->
    <item
        android:bottom="32dp"
        android:left="32dp"
        android:right="32dp"
        android:top="32dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_vinyl_groove" />
        </shape>
    </item>
</layer-list>
