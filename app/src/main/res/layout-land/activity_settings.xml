<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    tools:context=".activities.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="Settings"
        app:titleCentered="false"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:navigationIcon="@drawable/round_arrow_back_24"
        app:navigationIconTint="?attr/colorOnSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_mid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- First Column: Playback & Storage -->
            <LinearLayout
                android:id="@+id/section_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline_mid">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Playback &amp; Downloads"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/download_over_cellular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Download over cellular"
                            app:textOff="Downloads start or continue only when connected to Wi-Fi."
                            app:textOn="Downloads start or continue on Wi-Fi or cellular." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/high_quality_track"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="High quality streaming"
                            app:textOff="Streams at lower quality to save cellular bandwidth."
                            app:textOn="Streams at maximum 320kbps quality everywhere." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/explicit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Allow explicit tracks"
                            app:textOff="Explicit 18+ tracks are blocked from playing."
                            app:textOn="Explicit 18+ songs are allowed to play." />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/player_gestures"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Player Gestures"
                            app:textOff="Gestures disabled in music player."
                            app:textOn="Swipe left/right for tracks, drag down to minimize." />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/tap_album_lyrics_toggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Tap Album to Toggle Lyrics"
                            app:textOff="Tapping album cover will not toggle lyrics."
                            app:textOn="Tap album cover art to quickly view synchronized lyrics." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Storage &amp; Cache"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/store_in_cache"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Cache song &amp; album data"
                            app:textOff="Does not cache metadata. Higher data consumption."
                            app:textOn="Caches metadata locally for fast instant loading." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/clear_cache"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Clear cached data"
                                    android:textColor="?attr/colorError"
                                    android:textSize="15sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Frees up disk storage used by cached API responses"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/round_close_24"
                                app:tint="?attr/colorError" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Second Column: Material 3 Theme Manager -->
            <LinearLayout
                android:id="@+id/section_other"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guideline_mid"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Theme &amp; Appearance"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Mode"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp" />

                        <RadioGroup
                            android:id="@+id/theme_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/system"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Follow System"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/dark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dark Theme"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/light"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Light Theme"
                                android:textColor="?attr/colorOnSurface" />
                        </RadioGroup>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/dynamic_color_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Material You Dynamic Color"
                            app:textOff="Using selected curated color palette below."
                            app:textOn="Tints app using your device wallpaper colors (Android 12+)." />

                        <!-- Palette Selector -->
                        <LinearLayout
                            android:id="@+id/palette_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Color Palette"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/palette_chip_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/palette_emerald"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Emerald" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/palette_ocean"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ocean" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/palette_purple"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Purple" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/palette_crimson"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Crimson" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/palette_amber"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Amber" />
                            </com.google.android.material.chip.ChipGroup>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.harsh.shah.saavnmp3.utils.customview.MaterialCustomSwitch
                            android:id="@+id/amoled_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textHead="Pure Black AMOLED"
                            app:textOff="Standard Material 3 dark surface colors."
                            app:textOn="Pure #000000 background for OLED screens." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
